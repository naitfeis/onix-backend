# Application / dump SOURCE (may be pooler or direct). Never used as pg_restore target.
DATABASE_URL="postgresql://user:password@localhost:5432/onix"

# Scratch RESTORE TARGET for ops:backup-drill (must be a separate DB/branch).
# MUST be a Neon Direct endpoint (host must NOT contain "-pooler").
# Do NOT copy DATABASE_URL here. Do NOT use the placeholder "postgresql://...".
# Do NOT invent a host by stripping "-pooler" — copy Direct from Neon console.
# PowerShell:
#   $env:RESTORE_DATABASE_URL = "postgresql://<user>:<password>@<direct-scratch-endpoint>/neondb?sslmode=require"
#   npm run ops:backup-drill -- diagnose
#   npm run ops:backup-drill -- diagnose-restore
#   npm run ops:backup-drill -- verify
# RESTORE_DATABASE_URL="postgresql://<direct-scratch-endpoint>/neondb?sslmode=require"

BOT_TOKEN=
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_TELEGRAM_ID=
# Browser never calls Render. Keep www.onixtg.shop (+ localhost for Vite) for any residual CORS.
CORS_ORIGINS=http://localhost:5173,https://www.onixtg.shop,https://onixtg.shop
# Amvera DNS-only: leave unset (AMVERA=1 ignores spoofable CF / X-Real-IP / leftmost XFF).
# TRUST_CDN_HEADERS=true
# Production host allowlist (comma-separated). Rejects literal-IP Host.
# ALLOWED_HOSTS=www.onixtg.shop,onixtg.shop
# Optional shared secret from a future RU-friendly edge (header X-ONIX-Edge-Secret).
# ORIGIN_EDGE_SECRET=
# ORIGIN_GUARD=on
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
JWT_TTL_DAYS=7
PORT=3000

# Shared coordination. Redis is mandatory in production and whenever
# WEB_CONCURRENCY > 1 or SCALE_OUT=true. Keep REDIS_URL in the secret store.
# Local development/tests default to the bounded in-memory adapter.
COORDINATION_BACKEND=auto
# REDIS_URL=redis://default:<secret>@localhost:6379
# WEB_CONCURRENCY=1
# SCALE_OUT=false

# Auto-delivery AES-256-GCM key (REQUIRED for product autoDeliver). 32-byte base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Local: paste into this repo's root .env (same folder as package.json).
# Render: Dashboard → your API service → Environment → Add PRODUCT_DELIVERY_KEY → Redeploy.
# Without this key, creating a product with «Автовыдача» returns 400.
PRODUCT_DELIVERY_KEY=

# Optional SUPPORT staff (comma-separated Telegram IDs); admins always count as support.
# SUPPORT_TELEGRAM_IDS=

# Auth V2 Website access JWT (REQUIRED for Bot Login POST /telegram-bot/complete)
# Generate: npm run auth:generate-ed25519 -- --render
AUTH_ED25519_CURRENT_KID=
AUTH_ED25519_CURRENT_PRIVATE_PEM=
AUTH_ED25519_CURRENT_PUBLIC_PEM=
# Optional rotation (verify-only):
# AUTH_ED25519_PREVIOUS_KID=
# AUTH_ED25519_PREVIOUS_PUBLIC_PEM=

# Device trust HMAC (required in production — never reuse JWT_SECRET there)
# DEVICE_HMAC_SECRET=

# Slice 6 — optional admin/support IP allowlist (comma-separated). Empty = not enforced.
# ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.7

# Slice 6 — bootstrap first AdminUser when table is empty (min 12 chars password).
# ADMIN_BOOTSTRAP_EMAIL=ops@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-long-random
# ADMIN_BOOTSTRAP_TELEGRAM_ID=123456789
# ADMIN_MFA_DEBUG=true

# Domain APIs (/api/users/me, wallet, …) accepting EdDSA access — enable after keys work
# AUTH_ACCEPT_V2_ACCESS=true

# Website build: leave empty so browser uses same-origin /api (Vercel rewrite → Render).
VITE_API_URL=
# Optional local Vite proxy target (defaults to http://localhost:3000).
# VITE_API_PROXY_TARGET=https://onix-api-47tj.onrender.com
VITE_TELEGRAM_BOT_USERNAME=Onixshop_bot

# Google Sign-In — same ID on API and website.
# Amvera: set only GOOGLE_CLIENT_ID (runtime). SPA reads it from GET /api/v2/auth/public-config.
# Rebuild with VITE_GOOGLE_CLIENT_ID is optional.
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# Optional override if Google Console has a different Authorized redirect URI:
# GOOGLE_REDIRECT_URI=https://www.onixtg.shop/auth/google
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# VITE_WEBSITE_AUTH_MODE=auth_v2

# Cloudflare R2 — chat file attachments (JPEG/PNG/WebP/GIF/PDF/TXT).
# Uploads stay off by default: browser PUT to R2 often fails from RU.
# CHAT_ATTACHMENTS_ENABLED=true
# Without R2 keys, chat upload returns «Загрузка файлов временно недоступна».
# Create a bucket + S3 API token in Cloudflare R2, then set on Amvera (runtime, no rebuild):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Optional custom endpoint (default https://<accountid>.r2.cloudflarestorage.com):
# R2_ENDPOINT=

# T-Bank Acquiring sandbox (СБП QR + карта). Never commit live keys.
# Create a test terminal in Т-Банк → Интернет-эквайринг → тестовый контур.
# TINKOFF_TERMINAL_KEY=
# TINKOFF_PASSWORD=
# TINKOFF_SANDBOX=true
# Notification URL: https://www.onixtg.shop/api/payments/tinkoff/notification
