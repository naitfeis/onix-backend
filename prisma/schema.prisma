// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Статусы заказов (Жизненный цикл сделки в Гаранте)
enum OrderStatus {
  PENDING
  PAYMENT_HOLD
  DELIVERING
  COMPLETED
  CANCELED
  DISPUTE
  REFUNDED
}

/// Статусы товаров
enum ProductStatus {
  ACTIVE
  RESERVED
  SOLD_OUT
  ARCHIVED
}

/// Таблица пользователей сайта
model User {
  id            BigInt    @id @default(autoincrement())
  email         String?   @unique(map: "User_email_key")

  /// Telegram-интеграция
  telegramId    BigInt?   @unique(map: "User_telegramId_key")
  telegramNick  String?
  telegramToken String?   @unique(map: "User_telegramToken_key")

  /// Мягкое удаление пользователя (сохраняет историю заказов)
  deletedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Связи
  products      Product[]
  buyerOrders   Order[] @relation("Buyer")
  sellerOrders  Order[] @relation("Seller")
}

/// Таблица товаров
model Product {
  id            String    @id @default(cuid())

  title         String    @db.VarChar(255)
  description   String?   @db.VarChar(1500) // Защита от спама в описании

  price         Decimal   @db.Decimal(18, 2) @default(0.0)

  category      String    @db.VarChar(100)
  quantity      Int       @default(0)

  status        ProductStatus @default(ACTIVE)

  sellerId      BigInt
  seller        User      @relation(fields: [sellerId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]

  /// Индекс для моментальной фильтрации товаров по играм на витрине
  @@index([category, status])
}

/// Таблица сделок (Система Гаранта)
model Order {
  id            BigInt    @id @default(autoincrement()) // Изменено на BigInt для экономии RAM

  productId     String
  product       Product   @relation(fields: [productId], references: [id])

  buyerId       BigInt
  buyer         User      @relation("Buyer", fields: [buyerId], references: [id])

  sellerId      BigInt
  seller        User      @relation("Seller", fields: [sellerId], references: [id])

  totalAmount   Decimal   @db.Decimal(18, 2) @default(0.0)
  status        OrderStatus @default(PENDING)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}