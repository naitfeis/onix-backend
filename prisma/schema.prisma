generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             BigInt    @id @default(autoincrement())
  telegramId     BigInt    @unique
  onixId         String    @unique @db.VarChar(20)
  telegramNick   String?   @db.VarChar(64)
  displayName    String?   @db.VarChar(120)
  avatarUrl      String?   @db.VarChar(500)
  bio            String?   @db.VarChar(500)
  balanceCents   BigInt    @default(0)
  ratingAverage  Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount    Int       @default(0)
  completedSales Int       @default(0)
  lastSeenAt     DateTime  @default(now())
  isAdmin        Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products        Product[]
  buyerOrders     Order[]        @relation("Buyer")
  sellerOrders    Order[]        @relation("Seller")
  ledgerEntries   LedgerEntry[]
  favorites       Favorite[]
  following       Follow[]       @relation("Following")
  followers       Follow[]       @relation("Followers")
  chatMembers     ChatMember[]
  sentMessages    Message[]
  blocksMade      UserBlock[]    @relation("Blocker")
  blocksReceived  UserBlock[]    @relation("Blocked")
  notifications   Notification[]
  reviewsAuthored Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewSubject")
  auditLogs       AuditLog[]     @relation("AuditActor")
}

model Product {
  id          String          @id @default(cuid())
  title       String          @db.VarChar(255)
  description String?         @db.VarChar(1500)
  priceCents  BigInt
  category    ProductCategory
  subcategory String?         @db.VarChar(100)
  quantity    Int             @default(1)
  status      ProductStatus   @default(ACTIVE)
  sellerId    BigInt
  publishedAt DateTime        @default(now())
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  seller    User       @relation(fields: [sellerId], references: [id])
  orders    Order[]
  favorites Favorite[]

  @@index([category, status, createdAt])
  @@index([sellerId, status])
  @@index([title])
}

model Favorite {
  userId    BigInt
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Follow {
  followerId BigInt
  sellerId   BigInt
  createdAt  DateTime @default(now())
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User     @relation("Followers", fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([followerId, sellerId])
}

model Order {
  id               BigInt      @id @default(autoincrement())
  productId        String
  buyerId          BigInt
  sellerId         BigInt
  totalAmountCents BigInt
  feeCents         BigInt      @default(0)
  payoutCents      BigInt
  quantity         Int         @default(1)
  status           OrderStatus @default(PENDING)
  idempotencyKey   String      @unique @db.VarChar(100)
  disputeReason    String?     @db.VarChar(1000)
  canceledAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  buyer         User              @relation("Buyer", fields: [buyerId], references: [id])
  seller        User              @relation("Seller", fields: [sellerId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  transitions   OrderTransition[]
  ledgerEntries LedgerEntry[]
  chat          Chat?
  reviews       Review[]

  @@index([buyerId, status])
  @@index([sellerId, status])
}

model OrderTransition {
  id             BigInt       @id @default(autoincrement())
  orderId        BigInt
  from           OrderStatus?
  to             OrderStatus
  actorId        BigInt?
  idempotencyKey String?      @unique @db.VarChar(120)
  reason         String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model LedgerEntry {
  id                BigInt          @id @default(autoincrement())
  userId            BigInt
  orderId           BigInt?
  type              LedgerEntryType
  amountCents       BigInt
  balanceAfterCents BigInt
  idempotencyKey    String          @unique @db.VarChar(120)
  description       String?         @db.VarChar(500)
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id])
  order             Order?          @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
}

model Chat {
  id        String       @id @default(cuid())
  orderId   BigInt?      @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  order     Order?       @relation(fields: [orderId], references: [id])
  members   ChatMember[]
  messages  Message[]
}

model ChatMember {
  chatId     String
  userId     BigInt
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
}

model Message {
  id        BigInt   @id @default(autoincrement())
  chatId    String
  senderId  BigInt
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([chatId, createdAt])
}

model UserBlock {
  blockerId BigInt
  blockedId BigInt
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(500)
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Review {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt
  authorId  BigInt
  subjectId BigInt
  rating    Int
  text      String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id])

  @@unique([orderId, authorId])
  @@index([subjectId, createdAt])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
}

enum ProductStatus {
  ACTIVE
  RESERVED
  SOLD_OUT
  ARCHIVED
}

enum ProductCategory {
  STANDOFF_2
  STEAM
  ROBLOX
  RP_PROJECTS
  BRAWL_STARS
  OTHER
}

enum OrderStatus {
  PENDING
  PAYMENT_HOLD
  DELIVERING
  COMPLETED
  CANCELED
  DISPUTE
  REFUNDED
}

enum LedgerEntryType {
  DEPOSIT
  PURCHASE_HOLD
  REFUND
  SALE_PAYOUT
  ADMIN_ADJUSTMENT
  WITHDRAWAL
}

enum NotificationType {
  NEW_PRODUCT
  NEW_MESSAGE
  ORDER_UPDATE
  NEW_REVIEW
  SYSTEM
}
