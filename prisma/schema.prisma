  DIRECT
  GROUP
  AI
}

enum MessageKind {
  USER
  SYSTEM
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

/** Public account status (everyone starts as USER). */
enum PlatformStatus {
  USER
  VERIFIED_SELLER
  MODERATOR
  ADMIN
  /** Bootstrap / root admin — only this role may grant or revoke ADMIN. */
  SUPER_ADMIN
  VIP
}

enum BanReason {
  MISCONDUCT
  THIRD_PARTY_ADS
  OFF_PLATFORM_DEAL
  FRAUD
  SELLER_NO_RESPONSE
  OTHER
}

enum OrderStatus {
  PENDING
  PAYMENT_HOLD
  DELIVERING
  COMPLETED
  CANCELED
  DISPUTE
  REFUNDED
}

