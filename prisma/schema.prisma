generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                BigInt    @id @default(autoincrement())
  telegramId        BigInt?   @unique
  onixId            String    @unique @db.VarChar(20)
  telegramNick      String?   @db.VarChar(64)
  firstName         String?   @db.VarChar(120)
  lastName          String?   @db.VarChar(120)
  languageCode      String?   @db.VarChar(16)
  displayName       String?   @db.VarChar(120)
  avatarUrl         String?   @db.VarChar(500)
  bio               String?   @db.VarChar(500)
  balanceCents           BigInt    @default(0)
  /** Deposit wallet — available to withdraw (not usable for purchases). */
  depositAvailableCents  BigInt    @default(0)
  /** Deposit wallet — frozen after sales / disputes. */
  depositLockedCents     BigInt    @default(0)
  /** Internal Trust Score 0..1000 — never expose on public seller DTOs. */
  trustScore             Int       @default(0)
  /** Cached public trust level 1..5 derived from trustScore. */
  trustLevel             Int       @default(1) @db.SmallInt
  trustScoreVersion      Int       @default(2)
  trustComputedAt        DateTime?
  trustDirty             Boolean   @default(true)
  ratingAverage          Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount            Int       @default(0)
  completedSales         Int       @default(0)
  sessionVersion         Int       @default(0)
  permissionVersion      Int       @default(0)
  securityScore          Int       @default(0)
  securityScoreAt        DateTime?
  lastSeenAt             DateTime  @default(now())
  lastLoginAt            DateTime?
  isAdmin                Boolean   @default(false)
  isSupport              Boolean   @default(false)
  /** Public platform status — default USER; admin assigns others. Syncs isAdmin/isSupport. */
  platformStatus         PlatformStatus @default(USER)
  deletedAt              DateTime?
  banReason              BanReason?
  banComment             String?   @db.VarChar(1000)
  bannedAt               DateTime?
  bannedUntil            DateTime?
  /** When set, user cannot create/update listings (account still works). */
  sellBannedAt           DateTime?
  mergedIntoUserId       BigInt?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  products              Product[]
  buyerOrders           Order[]              @relation("Buyer")
  sellerOrders          Order[]              @relation("Seller")
  ledgerEntries         LedgerEntry[]
  ledgerEntriesAsActor  LedgerEntry[]        @relation("LedgerActor")
  depositLedgerEntries  DepositLedgerEntry[]
  depositLocks          DepositLock[]
  orderClawbacks        OrderClawback[]
  paymentIntents        PaymentIntent[]
  trustHistory          TrustHistoryEvent[]
  sellerSubscription    SellerSubscription?
  sellerAnalyticsDaily  SellerAnalyticsDaily[]
  productViewUniques    ProductViewUnique[]  @relation("ViewViewer")
  favorites             Favorite[]
  following             Follow[]             @relation("Following")
  followers             Follow[]             @relation("Followers")
  chatMembers           ChatMember[]
  sentMessages          Message[]
  visibleMessages       Message[]            @relation("MessageVisibleTo")
  deletedMessages       Message[]            @relation("MessageDeletedBy")
  messageHides          MessageHide[]
  blocksMade            UserBlock[]          @relation("Blocker")
  blocksReceived        UserBlock[]          @relation("Blocked")
  notifications         Notification[]
  reviewsAuthored       Review[]             @relation("ReviewAuthor")
  reviewsReceived       Review[]             @relation("ReviewSubject")
  reportsMade           UserReport[]         @relation("ReportAuthor")
  reportsReceived       UserReport[]         @relation("ReportTarget")
  auditLogs             AuditLog[]           @relation("AuditActor")
  supportTickets        SupportTicket[]
  identityLinks         IdentityLink[]
  sessions              Session[]
  userRoles             UserRole[]
  trustedDevices        TrustedDevice[]
  mfaFactors            MfaFactor[]
  mfaChallenges         MfaChallenge[]

  @@index([platformStatus])
}

model Product {
  id                 String              @id @default(cuid())
  /** Public short code ONIXLOT-{lotNumber}. */
  lotNumber          Int                 @unique @default(autoincrement())
  title              String              @db.VarChar(255)
  description        String?             @db.Text
  priceCents         BigInt
  category           ProductCategory
  subcategory        ProductSubcategory?
  quantity           Int                 @default(1)
  status             ProductStatus       @default(ACTIVE)
  autoDeliver         Boolean             @default(false)
  deliveryCiphertext String?             @db.Text
  deliveryIv         String?             @db.VarChar(64)
  deliveryConsumedAt DateTime?
  sellerId           BigInt
  publishedAt        DateTime            @default(now())
  expiresAt          DateTime
  /** Escrow hold after completion, hours. Default 10. Range 5..720 (30 days). */
  warrantyHours      Int                 @default(10)
  /** Hidden from catalog while seller is offline 3+ days. Not a public ban. */
  shadowBannedAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  seller      User               @relation(fields: [sellerId], references: [id])
  orders      Order[]
  favorites   Favorite[]
  viewUniques ProductViewUnique[]

  @@index([category, status, createdAt])
  @@index([category, subcategory, status])
  @@index([sellerId, status])
  @@index([title])
  @@index([status, createdAt])
  @@index([status, priceCents])
  @@index([status, shadowBannedAt, createdAt])
  @@index([warrantyHours])
}

model Favorite {
  userId    BigInt
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId, createdAt])
  @@index([createdAt])
}

model Follow {
  followerId BigInt
  sellerId   BigInt
  createdAt  DateTime @default(now())
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User     @relation("Followers", fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([followerId, sellerId])
  @@index([sellerId])
}

model Order {
  id               BigInt      @id @default(autoincrement())
  productId        String
  buyerId          BigInt
  sellerId         BigInt
  totalAmountCents BigInt
  feeCents         BigInt      @default(0)
  payoutCents      BigInt
  quantity         Int         @default(1)
  status           OrderStatus @default(PENDING)
  idempotencyKey   String      @unique @db.VarChar(100)
  disputeReason    String?     @db.VarChar(1000)
  canceledAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  buyer          User               @relation("Buyer", fields: [buyerId], references: [id])
  seller         User               @relation("Seller", fields: [sellerId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  transitions    OrderTransition[]
  ledgerEntries  LedgerEntry[]
  depositLocks   DepositLock[]
  clawback       OrderClawback?
  /** Personal pair chat shared across all deals between buyer and seller. */
  chatId         String?
  chat           Chat?              @relation(fields: [chatId], references: [id])
  reviews        Review[]
  supportTickets SupportTicket[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([chatId])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([sellerId, completedAt])
  @@index([chatId, createdAt])
}

/**
 * Post-COMPLETED refund obligation when seller balance cannot cover full clawback.
 * Ledger never goes negative — remaining debt lives here until recovered/waived.
 */
model OrderClawback {
  id              String         @id @default(cuid())
  orderId         BigInt         @unique
  sellerId        BigInt
  /** Total payout that must be recovered from seller. */
  amountCents     BigInt
  /** Already recovered via ledger ADMIN_ADJUSTMENT debits. */
  recoveredCents  BigInt         @default(0)
  status          ClawbackStatus @default(OPEN)
  reason          String?        @db.VarChar(1000)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller User  @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status])
  @@index([status, updatedAt])
}

/** Pool-safe job lease (advisory-lock equivalent under Prisma connection pooling). */
model WorkerJobLease {
  jobName     String   @id @db.VarChar(64)
  holderId    String   @db.VarChar(64)
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model OrderTransition {
  id             BigInt       @id @default(autoincrement())
  orderId        BigInt
  from           OrderStatus?
  to             OrderStatus
  actorId        BigInt?
  idempotencyKey String?      @unique @db.VarChar(120)
  reason         String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model LedgerEntry {
  id                BigInt          @id @default(autoincrement())
  userId            BigInt
  orderId           BigInt?
  type              LedgerEntryType
  amountCents       BigInt
  balanceAfterCents BigInt
  idempotencyKey    String          @unique @db.VarChar(120)
  description       String?         @db.VarChar(500)
  /** Who initiated the mutation (self, admin, or null for pure system/provider). */
  actorUserId       BigInt?
  /** Origin of the money movement (Slice 4 Financial Controls). */
  source            LedgerSource    @default(SYSTEM)
  /** X-Request-Id or worker-generated correlation id — never tokens. */
  correlationId     String?         @db.VarChar(64)
  /** Slice 4.1 — economic provenance for withdraw rules. */
  fundKind          LedgerFundKind  @default(SYSTEM)
  /** Set when fundKind = SALE_PROCEEDS (ACCOUNT vs OTHER digital goods). */
  saleKind          LedgerSaleKind?
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id])
  order             Order?          @relation(fields: [orderId], references: [id])
  actor             User?           @relation("LedgerActor", fields: [actorUserId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, fundKind, createdAt])
}

model Chat {
  id        String          @id @default(cuid())
  /** Stable pair key `d:{minUserId}:{maxUserId}` — one personal chat per user pair. `ai:{userId}` for ONIX AI. */
  pairKey   String?         @unique @db.VarChar(64)
  kind      ChatKind        @default(DIRECT)
  title     String?         @db.VarChar(120)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  orders    Order[]
  members   ChatMember[]
  messages  Message[]
  tickets   SupportTicket[]

  @@index([updatedAt])
}

model ChatMember {
  chatId     String
  userId     BigInt
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id              BigInt      @id @default(autoincrement())
  chatId          String
  senderId        BigInt?
  /** When set, only this user (buyer) can read the message — used for auto-delivery secrets. */
  visibleToUserId BigInt?
  kind            MessageKind @default(USER)
  text            String      @db.VarChar(4500)
  createdAt       DateTime    @default(now())
  /** Soft global delete — row kept for admin audit. */
  deletedAt       DateTime?
  deletedById     BigInt?
  deletedReason   String?     @db.VarChar(500)
  /** True when removed for everyone (not just MessageHide for one user). */
  deletedForAll   Boolean     @default(false)
  chat            Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender          User?       @relation(fields: [senderId], references: [id])
  deletedBy       User?       @relation("MessageDeletedBy", fields: [deletedById], references: [id])
  visibleTo       User?       @relation("MessageVisibleTo", fields: [visibleToUserId], references: [id])
  hides           MessageHide[]

  @@index([chatId, createdAt]) // history: WHERE chatId ORDER BY createdAt
  // Partial USER+senderId index: migration 20260716050000. Add more only after EXPLAIN ANALYZE.
  @@index([visibleToUserId])
  @@index([deletedAt])
}

/** Per-user hide ("удалить у себя") — message stays for peers / admin. */
model MessageHide {
  messageId BigInt
  userId    BigInt
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model UserReport {
  id         String    @id @default(cuid())
  reporterId BigInt
  targetId   BigInt
  reason     BanReason
  comment    String    @db.VarChar(1000)
  /** USER = complaint about a person; AI_SUPPORT = message from ONIX AI support widget. */
  kind       String    @default("USER") @db.VarChar(20)
  adminReply String?   @db.VarChar(2000)
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  closedById BigInt?
  reviewId   BigInt?
  review     Review?   @relation(fields: [reviewId], references: [id])
  reporter   User      @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  target     User      @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, createdAt])
  @@index([reporterId, createdAt])
  @@index([closedAt, createdAt])
  @@index([kind, closedAt, createdAt])
  @@index([reviewId])
}

model SupportTicket {
  id         String              @id @default(cuid())
  orderId    BigInt
  chatId     String
  openedById BigInt
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  closedAt   DateTime?
  order      Order               @relation(fields: [orderId], references: [id])
  chat       Chat                @relation(fields: [chatId], references: [id])
  openedBy   User                @relation(fields: [openedById], references: [id])

  @@index([orderId, status])
  @@index([chatId])
  @@index([status, createdAt])
}

model UserBlock {
  blockerId BigInt
  blockedId BigInt
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(500)
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  /** Null = Telegram outbox pending. Set after Bot API success or when user has no telegramId. */
  telegramPushedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([telegramPushedAt, createdAt])
}

model Review {
  id           BigInt    @id @default(autoincrement())
  orderId      BigInt
  authorId     BigInt
  subjectId    BigInt
  rating       Int
  text         String?   @db.VarChar(1000)
  hiddenAt     DateTime?
  hiddenReason String?   @db.VarChar(20)
  createdAt    DateTime  @default(now())
  order        Order     @relation(fields: [orderId], references: [id])
  author       User      @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject      User      @relation("ReviewSubject", fields: [subjectId], references: [id])
  reports      UserReport[]

  @@unique([orderId, authorId])
  @@index([subjectId, createdAt])
  @@index([subjectId, hiddenAt])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
}

/// Worker job run journal (ops / drills / alerting).
model WorkerJobRun {
  id         String    @id @default(cuid())
  jobName    String    @db.VarChar(64)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  processed  Int       @default(0)
  error      String?   @db.VarChar(1000)
  metadata   Json?

  @@index([jobName, startedAt])
}

// ─── Seller Trust & Economy foundation (Stage 1) ─────────────────────────────

enum PaymentWallet {
  MAIN
  DEPOSIT
}

enum PaymentProviderCode {
  MANUAL
  YOOKASSA
  TELEGRAM_WALLET
  CRYPTO
  CARD
  STRIPE
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
}

enum DepositLedgerType {
  TOPUP
  WITHDRAW
  LOCK
  UNLOCK
  SEIZE
  ADMIN_ADJUST
}

enum DepositLockStatus {
  ACTIVE
  RELEASED
  HELD_DISPUTE
  SEIZED
}

enum TrustHistoryType {
  LEVEL_UP
  LEVEL_DOWN
  DEPOSIT_CHANGED
  DEPOSIT_LOCKED
  DEPOSIT_UNLOCKED
  PHONE_VERIFIED
  PASSPORT_VERIFIED
  VOICE_VERIFIED
  VERIFICATION_REVOKED
  PENALTY
  PRO_GRANTED
  PRO_ENDED
  BADGE_GRANTED
  RECOMPUTE
}

enum SellerSubscriptionPlan {
  PRO
}

enum SellerSubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

/// Provider-agnostic top-up intent. Business code never talks to PSP SDKs directly.
model PaymentIntent {
  id             String               @id @default(cuid())
  userId         BigInt
  wallet         PaymentWallet
  provider       PaymentProviderCode
  amountCents    BigInt
  currency       String               @default("RUB") @db.VarChar(8)
  status         PaymentIntentStatus  @default(CREATED)
  idempotencyKey String               @unique @db.VarChar(120)
  /** PSP payment id — unique per provider when set (webhook correlation). */
  providerRef    String?              @db.VarChar(191)
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  succeededAt    DateTime?
  user           User                 @relation(fields: [userId], references: [id])

  @@unique([provider, providerRef])
  @@index([userId, status, createdAt])
  @@index([provider, status])
}

model DepositLedgerEntry {
  id                 BigInt            @id @default(autoincrement())
  userId             BigInt
  type               DepositLedgerType
  amountCents        BigInt
  availableAfterCents BigInt
  lockedAfterCents   BigInt
  orderId            BigInt?
  lockId             String?
  paymentIntentId    String?           @db.VarChar(64)
  idempotencyKey     String            @unique @db.VarChar(120)
  description        String?           @db.VarChar(500)
  createdAt          DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([orderId])
}

model DepositLock {
  id          String            @id @default(cuid())
  userId      BigInt
  orderId     BigInt
  amountCents BigInt
  status      DepositLockStatus @default(ACTIVE)
  lockedAt    DateTime          @default(now())
  unlockAt    DateTime
  releasedAt  DateTime?
  user        User              @relation(fields: [userId], references: [id])
  order       Order             @relation(fields: [orderId], references: [id])

  @@unique([orderId])
  @@index([userId, status])
  @@index([status, unlockAt])
}

/// Append-only trust journal for analytics and transparency.
model TrustHistoryEvent {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt
  type      TrustHistoryType
  payload   Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Commercial ONIX PRO — independent of Trust Score / Level.
model SellerSubscription {
  id        String                   @id @default(cuid())
  userId    BigInt                   @unique
  plan      SellerSubscriptionPlan   @default(PRO)
  status    SellerSubscriptionStatus @default(ACTIVE)
  startsAt  DateTime                 @default(now())
  endsAt    DateTime?
  metadata  Json?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  user      User                     @relation(fields: [userId], references: [id])

  @@index([status, endsAt])
}

/// Unique product view — one row per (product, viewerKey). Foundation for Stage 2 analytics.
model ProductViewUnique {
  id         String   @id @default(cuid())
  productId  String
  sellerId   BigInt
  viewerKey  String   @db.VarChar(96)
  viewerUserId BigInt?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewer     User?    @relation("ViewViewer", fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@unique([productId, viewerKey])
  @@index([sellerId, firstSeenAt])
  @@index([productId, firstSeenAt])
}

/// Daily seller analytics rollup (Stage 2 UI reads this; Stage 1 creates schema only).
model SellerAnalyticsDaily {
  id                 String   @id @default(cuid())
  sellerId           BigInt
  day                DateTime @db.Date
  revenueCents       BigInt   @default(0)
  profitCents        BigInt   @default(0)
  ordersCount        Int      @default(0)
  completedCount     Int      @default(0)
  uniqueViews        Int      @default(0)
  favoritesAdded     Int      @default(0)
  repeatBuyers       Int      @default(0)
  impressions        Int      @default(0)
  clicks             Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  seller             User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, day])
  @@index([sellerId, day])
}

// ─── Auth platform (Phase 1 additive) ───────────────────────────────────────

enum AuthProvider {
  TELEGRAM
  GOOGLE
  APPLE
  DISCORD
  STEAM
  VK
  EMAIL
  PASSKEY
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  SESSION_LIMIT
  ADMIN
  REFRESH_REUSE
  RISK_ENGINE
  SESSION_VERSION
  EXPIRED
  SECURITY
}

enum AuthAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REFRESH
  LOGOUT
  PASSWORD_RESET
  IDENTITY_LINK
  IDENTITY_UNLINK
  SESSION_REVOKED
  ADMIN_LOGIN_AS_USER
  MFA_CHALLENGE_ISSUED
  MFA_CHALLENGE_PASSED
  MFA_CHALLENGE_FAILED
  SESSION_VERSION_BUMP
}

enum IdentityHistoryAction {
  LINKED
  UNLINKED
  RELINKED
  PROFILE_REFRESHED
  PRIMARY_CHANGED
  RECOVERY_MARKED
}

enum SecurityEventType {
  REFRESH_REUSE
  REFRESH_TOKEN_THEFT
  BRUTEFORCE
  TOO_MANY_LOGINS
  IMPOSSIBLE_TRAVEL
  SESSION_ANOMALY
  ACCOUNT_TAKEOVER_SUSPECTED
  REGISTRATION_BLOCKED
}

enum AbuseMarkerKind {
  FINGERPRINT
  BROWSER_ID
  IP
  USER_AGENT
}

enum SecurityEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  AUTO_MITIGATED
}

enum MfaMethod {
  TELEGRAM
  TOTP
  EMAIL
  PASSKEY
}

enum SigningKeyStatus {
  CURRENT
  PREVIOUS
  RETIRED
}

enum AccountMergeStatus {
  PENDING
  COMPLETED
  CANCELED
  FAILED
}

/// Website bot-login challenge state machine (ONIX Identity Platform Phase D).
enum LoginChallengeStatus {
  CREATED
  OPENED
  CONFIRMED
  CONSUMED
  EXPIRED
}

model IdentityLink {
  id              String       @id @default(cuid())
  userId          BigInt
  provider        AuthProvider
  providerUserId  String       @db.VarChar(191)
  username        String?      @db.VarChar(128)
  email           String?      @db.VarChar(320)
  displayName     String?      @db.VarChar(191)
  avatarUrl       String?      @db.VarChar(500)
  profileSnapshot Json?
  linkedAt        DateTime     @default(now())
  lastUsedAt      DateTime?
  deletedAt       DateTime?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId, deletedAt])
  @@index([provider, deletedAt])
}

model Session {
  id                  String               @id @default(cuid())
  userId              BigInt
  familyId            String               @db.VarChar(64)
  clientType          String               @db.VarChar(32) @default("WEB")
  refreshGeneration   Int                  @default(0)
  refreshTokenHash    String               @unique @db.VarChar(64)
  previousRefreshHash String?              @db.VarChar(64)
  lockVersion         Int                  @default(0)
  riskScore           Int                  @default(0)
  riskUpdatedAt       DateTime?
  rememberMe          Boolean              @default(false)
  deviceName          String?              @db.VarChar(120)
  browser             String?              @db.VarChar(64)
  os                  String?              @db.VarChar(64)
  platform            String?              @db.VarChar(64)
  timezone            String?              @db.VarChar(64)
  language            String?              @db.VarChar(32)
  userAgent           String?              @db.VarChar(512)
  fingerprintHash     String?              @db.VarChar(64)
  screenResolution    String?              @db.VarChar(32)
  webglHash           String?              @db.VarChar(64)
  canvasHash          String?              @db.VarChar(64)
  ipAddress           String?              @db.VarChar(64)
  asn                 Int?
  country             String?              @db.VarChar(2)
  city                String?              @db.VarChar(120)
  createdAt           DateTime             @default(now())
  lastSeenAt          DateTime             @default(now())
  refreshExpiresAt    DateTime
  absoluteExpiresAt   DateTime
  revokedAt           DateTime?
  revokeReason        SessionRevokeReason?
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastSeenAt])
  @@index([refreshExpiresAt])
  @@index([fingerprintHash])
  @@index([familyId])
  @@index([previousRefreshHash])
}

model AuthAuditLog {
  id          BigInt          @id @default(autoincrement())
  userId      BigInt?
  sessionId   String?
  action      AuthAuditAction
  provider    AuthProvider?
  ipAddress   String?         @db.VarChar(64)
  country     String?         @db.VarChar(2)
  userAgent   String?         @db.VarChar(512)
  fingerprint String?         @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model IdentityHistory {
  id             BigInt                @id @default(autoincrement())
  userId         BigInt
  provider       AuthProvider
  providerUserId String                @db.VarChar(191)
  action         IdentityHistoryAction
  identityLinkId String?
  actorUserId    BigInt?
  ipAddress      String?               @db.VarChar(64)
  metadata       Json?
  createdAt      DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([provider, providerUserId])
}

model SecurityEvent {
  id         BigInt              @id @default(autoincrement())
  type       SecurityEventType
  status     SecurityEventStatus @default(OPEN)
  userId     BigInt?
  sessionId  String?
  severity   Int                 @default(50)
  ipAddress  String?             @db.VarChar(64)
  country    String?             @db.VarChar(2)
  payload    Json
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Multi-factor abuse signals from banned accounts (Risk Score). Never block on IP alone.
model AbuseMarker {
  id           String          @id @default(cuid())
  kind         AbuseMarkerKind
  valueHash    String          @db.VarChar(64)
  sourceUserId BigInt
  createdAt    DateTime        @default(now())
  revokedAt    DateTime?

  @@unique([kind, valueHash])
  @@index([kind, valueHash, revokedAt])
  @@index([sourceUserId, revokedAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(120)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(120)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     BigInt
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy BigInt?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model TrustedDevice {
  id              String    @id @default(cuid())
  userId          BigInt
  fingerprintHash String    @db.VarChar(64)
  deviceName      String?   @db.VarChar(120)
  browser         String?   @db.VarChar(64)
  os              String?   @db.VarChar(64)
  trustedAt       DateTime  @default(now())
  expiresAt       DateTime?
  lastSeenAt      DateTime  @default(now())
  revokedAt       DateTime?
  trustSource     String    @db.VarChar(32)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, revokedAt])
}

model MfaFactor {
  id         String    @id @default(cuid())
  userId     BigInt
  method     MfaMethod
  label      String?   @db.VarChar(120)
  secretRef  String?   @db.VarChar(255)
  verifiedAt DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaChallenge {
  id        String    @id @default(cuid())
  userId    BigInt
  sessionId String?
  method    MfaMethod
  /** PENDING | CONFIRMED | CONSUMED | CANCELED | EXPIRED | FAILED */
  status    String    @db.VarChar(32)
  /** e.g. WITHDRAW — binds challenge to a high-risk action */
  purpose   String    @default("WITHDRAW") @db.VarChar(64)
  /** Non-secret context (amountCents, score) — never tokens */
  metadata  Json?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
}

model SigningKey {
  id           String           @id @default(cuid())
  kid          String           @unique @db.VarChar(64)
  algorithm    String           @db.VarChar(32) @default("EdDSA")
  publicKey    String           @db.Text
  privateKeyRef String          @db.VarChar(255)
  status       SigningKeyStatus @default(CURRENT)
  activatedAt  DateTime         @default(now())
  retiredAt    DateTime?
}

model AccountMergeRequest {
  id             String             @id @default(cuid())
  survivorUserId BigInt
  absorbedUserId BigInt
  status         AccountMergeStatus @default(PENDING)
  evidence       Json?
  createdAt      DateTime           @default(now())
  completedAt    DateTime?

  @@index([survivorUserId])
  @@index([absorbedUserId])
  @@index([status])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @db.VarChar(128)
  userId       BigInt?
  route        String   @db.VarChar(191)
  requestHash  String   @db.VarChar(64)
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([key, route])
  @@index([expiresAt])
}

/// Ephemeral Website Telegram bot-login challenge (not a Session; not an ONIX User).
model LoginChallenge {
  id                      String               @id @default(cuid())
  nonce                   String               @unique @db.VarChar(64)
  browserFingerprintHash  String?              @db.VarChar(64)
  loginSessionId          String               @db.VarChar(64)
  status                  LoginChallengeStatus @default(CREATED)
  expiresAt               DateTime
  telegramId              BigInt?
  telegramUsername        String?              @db.VarChar(64)
  telegramFirstName       String?              @db.VarChar(120)
  telegramLastName        String?              @db.VarChar(120)
  telegramPhotoUrl        String?              @db.VarChar(500)
  confirmedAt             DateTime?
  consumedAt              DateTime?
  exchangeCodeHash        String?              @unique @db.VarChar(64)
  exchangeExpiresAt       DateTime?
  createdIp               String?              @db.VarChar(64)
  createdUserAgent        String?              @db.VarChar(512)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([loginSessionId, status])
  @@index([status, expiresAt])
  @@index([telegramId])
}

