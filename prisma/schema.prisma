generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                BigInt    @id @default(autoincrement())
  telegramId        BigInt    @unique
  onixId            String    @unique @db.VarChar(20)
  telegramNick      String?   @db.VarChar(64)
  firstName         String?   @db.VarChar(120)
  lastName          String?   @db.VarChar(120)
  languageCode      String?   @db.VarChar(16)
  displayName       String?   @db.VarChar(120)
  avatarUrl         String?   @db.VarChar(500)
  bio               String?   @db.VarChar(500)
  balanceCents      BigInt    @default(0)
  ratingAverage     Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount       Int       @default(0)
  completedSales    Int       @default(0)
  sessionVersion    Int       @default(0)
  permissionVersion Int       @default(0)
  securityScore     Int       @default(0)
  securityScoreAt   DateTime?
  lastSeenAt        DateTime  @default(now())
  lastLoginAt       DateTime?
  isAdmin           Boolean   @default(false)
  isSupport         Boolean   @default(false)
  deletedAt         DateTime?
  banReason         BanReason?
  banComment        String?   @db.VarChar(1000)
  bannedAt          DateTime?
  bannedUntil       DateTime?
  mergedIntoUserId  BigInt?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  products        Product[]
  buyerOrders     Order[]        @relation("Buyer")
  sellerOrders    Order[]        @relation("Seller")
  ledgerEntries   LedgerEntry[]
  favorites       Favorite[]
  following       Follow[]       @relation("Following")
  followers       Follow[]       @relation("Followers")
  chatMembers     ChatMember[]
  sentMessages    Message[]
  blocksMade      UserBlock[]    @relation("Blocker")
  blocksReceived  UserBlock[]    @relation("Blocked")
  notifications   Notification[]
  reviewsAuthored Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewSubject")
  auditLogs       AuditLog[]     @relation("AuditActor")
  supportTickets  SupportTicket[]
  identityLinks   IdentityLink[]
  sessions        Session[]
  userRoles       UserRole[]
  trustedDevices  TrustedDevice[]
  mfaFactors      MfaFactor[]
  mfaChallenges   MfaChallenge[]
}

model Product {
  id                 String              @id @default(cuid())
  title              String              @db.VarChar(255)
  description        String?             @db.VarChar(1500)
  priceCents         BigInt
  category           ProductCategory
  subcategory        ProductSubcategory?
  quantity           Int                 @default(1)
  status             ProductStatus       @default(ACTIVE)
  autoDeliver         Boolean             @default(false)
  deliveryCiphertext String?             @db.Text
  deliveryIv         String?             @db.VarChar(64)
  deliveryConsumedAt DateTime?
  sellerId           BigInt
  publishedAt        DateTime            @default(now())
  expiresAt          DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  seller    User       @relation(fields: [sellerId], references: [id])
  orders    Order[]
  favorites Favorite[]

  @@index([category, status, createdAt])
  @@index([category, subcategory, status])
  @@index([sellerId, status])
  @@index([title])
}

model Favorite {
  userId    BigInt
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Follow {
  followerId BigInt
  sellerId   BigInt
  createdAt  DateTime @default(now())
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User     @relation("Followers", fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([followerId, sellerId])
}

model Order {
  id               BigInt      @id @default(autoincrement())
  productId        String
  buyerId          BigInt
  sellerId         BigInt
  totalAmountCents BigInt
  feeCents         BigInt      @default(0)
  payoutCents      BigInt
  quantity         Int         @default(1)
  status           OrderStatus @default(PENDING)
  idempotencyKey   String      @unique @db.VarChar(100)
  disputeReason    String?     @db.VarChar(1000)
  canceledAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  buyer         User              @relation("Buyer", fields: [buyerId], references: [id])
  seller        User              @relation("Seller", fields: [sellerId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  transitions   OrderTransition[]
  ledgerEntries LedgerEntry[]
  chat          Chat?
  reviews       Review[]
  supportTickets SupportTicket[]

  @@index([buyerId, status])
  @@index([sellerId, status])
}

model OrderTransition {
  id             BigInt       @id @default(autoincrement())
  orderId        BigInt
  from           OrderStatus?
  to             OrderStatus
  actorId        BigInt?
  idempotencyKey String?      @unique @db.VarChar(120)
  reason         String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model LedgerEntry {
  id                BigInt          @id @default(autoincrement())
  userId            BigInt
  orderId           BigInt?
  type              LedgerEntryType
  amountCents       BigInt
  balanceAfterCents BigInt
  idempotencyKey    String          @unique @db.VarChar(120)
  description       String?         @db.VarChar(500)
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id])
  order             Order?          @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
}

model Chat {
  id        String          @id @default(cuid())
  orderId   BigInt?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  order     Order?          @relation(fields: [orderId], references: [id])
  members   ChatMember[]
  messages  Message[]
  tickets   SupportTicket[]
}

model ChatMember {
  chatId     String
  userId     BigInt
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id        BigInt      @id @default(autoincrement())
  chatId    String
  senderId  BigInt?
  kind      MessageKind @default(USER)
  text      String      @db.VarChar(2000)
  createdAt DateTime    @default(now())
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User?       @relation(fields: [senderId], references: [id])

  @@index([chatId, createdAt])
}

model SupportTicket {
  id         String              @id @default(cuid())
  orderId    BigInt
  chatId     String
  openedById BigInt
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  closedAt   DateTime?
  order      Order               @relation(fields: [orderId], references: [id])
  chat       Chat                @relation(fields: [chatId], references: [id])
  openedBy   User                @relation(fields: [openedById], references: [id])

  @@index([orderId, status])
  @@index([chatId])
  @@index([status, createdAt])
}

model UserBlock {
  blockerId BigInt
  blockedId BigInt
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(500)
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Review {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt
  authorId  BigInt
  subjectId BigInt
  rating    Int
  text      String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id])

  @@unique([orderId, authorId])
  @@index([subjectId, createdAt])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
}

// ─── Auth platform (Phase 1 additive) ───────────────────────────────────────

enum AuthProvider {
  TELEGRAM
  GOOGLE
  APPLE
  DISCORD
  STEAM
  VK
  EMAIL
  PASSKEY
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  SESSION_LIMIT
  ADMIN
  REFRESH_REUSE
  RISK_ENGINE
  SESSION_VERSION
  EXPIRED
  SECURITY
}

enum AuthAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REFRESH
  LOGOUT
  PASSWORD_RESET
  IDENTITY_LINK
  IDENTITY_UNLINK
  SESSION_REVOKED
  ADMIN_LOGIN_AS_USER
  MFA_CHALLENGE_ISSUED
  MFA_CHALLENGE_PASSED
  MFA_CHALLENGE_FAILED
  SESSION_VERSION_BUMP
}

enum IdentityHistoryAction {
  LINKED
  UNLINKED
  RELINKED
  PROFILE_REFRESHED
  PRIMARY_CHANGED
  RECOVERY_MARKED
}

enum SecurityEventType {
  REFRESH_REUSE
  REFRESH_TOKEN_THEFT
  BRUTEFORCE
  TOO_MANY_LOGINS
  IMPOSSIBLE_TRAVEL
  SESSION_ANOMALY
  ACCOUNT_TAKEOVER_SUSPECTED
  REGISTRATION_BLOCKED
}

enum AbuseMarkerKind {
  FINGERPRINT
  BROWSER_ID
  IP
  USER_AGENT
}

enum SecurityEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  AUTO_MITIGATED
}

enum MfaMethod {
  TELEGRAM
  TOTP
  EMAIL
  PASSKEY
}

enum SigningKeyStatus {
  CURRENT
  PREVIOUS
  RETIRED
}

enum AccountMergeStatus {
  PENDING
  COMPLETED
  CANCELED
  FAILED
}

/// Website bot-login challenge state machine (ONIX Identity Platform Phase D).
enum LoginChallengeStatus {
  CREATED
  OPENED
  CONFIRMED
  CONSUMED
  EXPIRED
}

model IdentityLink {
  id              String       @id @default(cuid())
  userId          BigInt
  provider        AuthProvider
  providerUserId  String       @db.VarChar(191)
  username        String?      @db.VarChar(128)
  email           String?      @db.VarChar(320)
  displayName     String?      @db.VarChar(191)
  avatarUrl       String?      @db.VarChar(500)
  profileSnapshot Json?
  linkedAt        DateTime     @default(now())
  lastUsedAt      DateTime?
  deletedAt       DateTime?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId, deletedAt])
  @@index([provider, deletedAt])
}

model Session {
  id                  String               @id @default(cuid())
  userId              BigInt
  familyId            String               @db.VarChar(64)
  clientType          String               @db.VarChar(32) @default("WEB")
  refreshGeneration   Int                  @default(0)
  refreshTokenHash    String               @unique @db.VarChar(64)
  previousRefreshHash String?              @db.VarChar(64)
  lockVersion         Int                  @default(0)
  riskScore           Int                  @default(0)
  riskUpdatedAt       DateTime?
  rememberMe          Boolean              @default(false)
  deviceName          String?              @db.VarChar(120)
  browser             String?              @db.VarChar(64)
  os                  String?              @db.VarChar(64)
  platform            String?              @db.VarChar(64)
  timezone            String?              @db.VarChar(64)
  language            String?              @db.VarChar(32)
  userAgent           String?              @db.VarChar(512)
  fingerprintHash     String?              @db.VarChar(64)
  screenResolution    String?              @db.VarChar(32)
  webglHash           String?              @db.VarChar(64)
  canvasHash          String?              @db.VarChar(64)
  ipAddress           String?              @db.VarChar(64)
  asn                 Int?
  country             String?              @db.VarChar(2)
  city                String?              @db.VarChar(120)
  createdAt           DateTime             @default(now())
  lastSeenAt          DateTime             @default(now())
  refreshExpiresAt    DateTime
  absoluteExpiresAt   DateTime
  revokedAt           DateTime?
  revokeReason        SessionRevokeReason?
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastSeenAt])
  @@index([refreshExpiresAt])
  @@index([fingerprintHash])
  @@index([familyId])
  @@index([previousRefreshHash])
}

model AuthAuditLog {
  id          BigInt          @id @default(autoincrement())
  userId      BigInt?
  sessionId   String?
  action      AuthAuditAction
  provider    AuthProvider?
  ipAddress   String?         @db.VarChar(64)
  country     String?         @db.VarChar(2)
  userAgent   String?         @db.VarChar(512)
  fingerprint String?         @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model IdentityHistory {
  id             BigInt                @id @default(autoincrement())
  userId         BigInt
  provider       AuthProvider
  providerUserId String                @db.VarChar(191)
  action         IdentityHistoryAction
  identityLinkId String?
  actorUserId    BigInt?
  ipAddress      String?               @db.VarChar(64)
  metadata       Json?
  createdAt      DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([provider, providerUserId])
}

model SecurityEvent {
  id         BigInt              @id @default(autoincrement())
  type       SecurityEventType
  status     SecurityEventStatus @default(OPEN)
  userId     BigInt?
  sessionId  String?
  severity   Int                 @default(50)
  ipAddress  String?             @db.VarChar(64)
  country    String?             @db.VarChar(2)
  payload    Json
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Multi-factor abuse signals from banned accounts (Risk Score). Never block on IP alone.
model AbuseMarker {
  id           String          @id @default(cuid())
  kind         AbuseMarkerKind
  valueHash    String          @db.VarChar(64)
  sourceUserId BigInt
  createdAt    DateTime        @default(now())
  revokedAt    DateTime?

  @@unique([kind, valueHash])
  @@index([kind, valueHash, revokedAt])
  @@index([sourceUserId, revokedAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(120)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(120)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     BigInt
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy BigInt?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model TrustedDevice {
  id              String    @id @default(cuid())
  userId          BigInt
  fingerprintHash String    @db.VarChar(64)
  deviceName      String?   @db.VarChar(120)
  browser         String?   @db.VarChar(64)
  os              String?   @db.VarChar(64)
  trustedAt       DateTime  @default(now())
  expiresAt       DateTime?
  lastSeenAt      DateTime  @default(now())
  revokedAt       DateTime?
  trustSource     String    @db.VarChar(32)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, revokedAt])
}

model MfaFactor {
  id         String    @id @default(cuid())
  userId     BigInt
  method     MfaMethod
  label      String?   @db.VarChar(120)
  secretRef  String?   @db.VarChar(255)
  verifiedAt DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaChallenge {
  id        String    @id @default(cuid())
  userId    BigInt
  sessionId String?
  method    MfaMethod
  status    String    @db.VarChar(32)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model SigningKey {
  id           String           @id @default(cuid())
  kid          String           @unique @db.VarChar(64)
  algorithm    String           @db.VarChar(32) @default("EdDSA")
  publicKey    String           @db.Text
  privateKeyRef String          @db.VarChar(255)
  status       SigningKeyStatus @default(CURRENT)
  activatedAt  DateTime         @default(now())
  retiredAt    DateTime?
}

model AccountMergeRequest {
  id             String             @id @default(cuid())
  survivorUserId BigInt
  absorbedUserId BigInt
  status         AccountMergeStatus @default(PENDING)
  evidence       Json?
  createdAt      DateTime           @default(now())
  completedAt    DateTime?

  @@index([survivorUserId])
  @@index([absorbedUserId])
  @@index([status])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @db.VarChar(128)
  userId       BigInt?
  route        String   @db.VarChar(191)
  requestHash  String   @db.VarChar(64)
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([key, route])
  @@index([expiresAt])
}

/// Ephemeral Website Telegram bot-login challenge (not a Session; not an ONIX User).
model LoginChallenge {
  id                      String               @id @default(cuid())
  nonce                   String               @unique @db.VarChar(64)
  browserFingerprintHash  String?              @db.VarChar(64)
  loginSessionId          String               @db.VarChar(64)
  status                  LoginChallengeStatus @default(CREATED)
  expiresAt               DateTime
  telegramId              BigInt?
  telegramUsername        String?              @db.VarChar(64)
  telegramFirstName       String?              @db.VarChar(120)
  telegramLastName        String?              @db.VarChar(120)
  telegramPhotoUrl        String?              @db.VarChar(500)
  confirmedAt             DateTime?
  consumedAt              DateTime?
  exchangeCodeHash        String?              @unique @db.VarChar(64)
  exchangeExpiresAt       DateTime?
  createdIp               String?              @db.VarChar(64)
  createdUserAgent        String?              @db.VarChar(512)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([loginSessionId, status])
  @@index([status, expiresAt])
  @@index([telegramId])
}

enum ProductStatus {
  ACTIVE
  RESERVED
  SOLD_OUT
  ARCHIVED
}

enum ProductCategory {
  STANDOFF_2
  STEAM
  ROBLOX
  RP_PROJECTS
  BRAWL_STARS
  OTHER
}

enum ProductSubcategory {
  STANDOFF_GOLD
  STANDOFF_ACCOUNTS
  STANDOFF_SKINS
  STANDOFF_OTHER
  STEAM_TOPUP
  STEAM_ACCOUNTS
  STEAM_KEYS
  STEAM_SKINS
  STEAM_OTHER
  ROBLOX_ROBUX
  ROBLOX_ACCOUNTS
  ROBLOX_ITEMS
  ROBLOX_OTHER
  RP_VIRTS
  RP_ACCOUNTS
  RP_ITEMS
  RP_OTHER
  BRAWL_DONATE
  BRAWL_ACCOUNTS
  BRAWL_BOOST
  BRAWL_OTHER
  OTHER_ACCOUNTS
  OTHER_ITEMS
  OTHER_BOOST
  OTHER_MISC
}

enum MessageKind {
  USER
  SYSTEM
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

enum BanReason {
  MISCONDUCT
  THIRD_PARTY_ADS
  OFF_PLATFORM_DEAL
  FRAUD
  OTHER
}

enum OrderStatus {
  PENDING
  PAYMENT_HOLD
  DELIVERING
  COMPLETED
  CANCELED
  DISPUTE
  REFUNDED
}

enum LedgerEntryType {
  DEPOSIT
  PURCHASE_HOLD
  REFUND
  SALE_PAYOUT
  ADMIN_ADJUSTMENT
  WITHDRAWAL
}

enum NotificationType {
  NEW_PRODUCT
  NEW_MESSAGE
  ORDER_UPDATE
  NEW_REVIEW
  SYSTEM
}
