{
  "name": "onix-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "icons:knockout": "node scripts/knockout-brand-mark.mjs",
    "icons:all": "npm run icons:knockout && npm run icons:pwa"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@twa-dev/sdk": "^7.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.0.0"
  }
