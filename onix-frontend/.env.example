# REQUIRED empty for single-origin production:
# Browser → https://www.onixtg.shop/api/* → Vercel rewrite → Render.
# Never set this to https://onix-api-47tj.onrender.com (browser must not see Render).
VITE_API_URL=

# Local Vite proxy target only (not baked into browser bundle for API base).
# VITE_API_PROXY_TARGET=http://localhost:3000

VITE_TELEGRAM_BOT_USERNAME=Onixshop_bot

# Website login provider: bot (default) | widget (rollback only)
# VITE_WEBSITE_LOGIN_PROVIDER=bot

# Temporary Auth storage mode during cutover (legacy | auth_v2)
# VITE_WEBSITE_AUTH_MODE=legacy

# Google Sign-In (GIS). Same client ID as backend GOOGLE_CLIENT_ID.
# Create a Web OAuth client in Google Cloud Console, then add origins:
#   http://localhost:5173
#   https://www.onixtg.shop
#   https://onixtg.shop
# Production SPA reads GOOGLE_CLIENT_ID from GET /api/v2/auth/public-config (Amvera runtime).
# VITE_GOOGLE_CLIENT_ID is optional local fallback (Vite bakes it at build).
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
